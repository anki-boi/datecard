# DateCard runs in DEMO_MODE (everything in the browser, no setup) until these are set.
# Create a free Supabase project, run supabase/schema.sql, then copy its URL + anon key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the domain printed on cards and encoded in QR codes.
# Defaults to wherever the app is running (window.location.origin).
VITE_PUBLIC_URL=

# Optional: unlock every premium feature (3 cards, all designs, analytics).
# Handy for self-hosting — payments don't exist yet anyway.
VITE_UNLOCK_PREMIUM=

# Optional: unlocks the AI card writer and AI openers (client-side Gemini).
# NOTE: the key ships in the bundle. For production, proxy through an edge function (SPEC P2).
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
