# DateCard runs in DEMO_MODE (mock data) until these are set.
# Create a free Supabase project, then copy its URL + anon key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: unlocks the AI-assisted card builder (client-side Gemini).
# NOTE: for production, proxy through an edge function instead (see SPEC.md).
VITE_GEMINI_API_KEY=
